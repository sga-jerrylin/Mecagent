# 智能装配说明书生成系统 - 环境变量配置
# 复制此文件为 .env 并填入实际的API密钥

# ============ 必需的API密钥 ============

# 阿里云DashScope API密钥 (用于Qwen3-VL视觉模型)
# 获取地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# DeepSeek API密钥 (用于装配专家模型)
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenRouter API密钥 (用于Gemini模型，可选)
# 获取地址: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============ 可选配置 ============

# Blender可执行文件路径 (用于3D模型转换)
# 如果系统PATH中有blender命令，可以不设置
# BLENDER_EXE=/usr/bin/blender

# 调试模式 (true/false)
DEBUG=false

# 详细日志 (true/false)
VERBOSE=false

# ============ 使用说明 ============
# 1. 复制此文件: cp .env.example .env
# 2. 编辑 .env 文件，填入实际的API密钥
# 3. 确保 .env 文件不要提交到Git仓库

